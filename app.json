{
  "expo": {
    "name": "GESTIPRO",
    "slug": "GESTIPRO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gestipro.app",
      "adaptiveIcon": {
        "backgroundColor": "#9A1B2F",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#9A1B2F"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9a2a46f3-4363-4992-a5d3-fb52403b6fae"
      }
    },
    "owner": "0748926625"
  }
}
